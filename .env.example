# Copy to .env and replace every value. Never commit .env.
# Generate a key: python -c "import secrets; print(secrets.token_urlsafe(50))"

DJANGO_SECRET_KEY=replace-me-with-a-long-random-value
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://localhost
DJANGO_ADMIN_URL=staff-change-me/
# Optional: only these networks reach the admin (comma-separated, e.g. 203.0.113.7/32). Empty = any.
DJANGO_ADMIN_ALLOWED_NETWORKS=
STAFF_IDLE_TIMEOUT_S=1800
DJANGO_LOG_LEVEL=INFO
# True only behind our reverse proxy (Caddy). Default: true in prod, false elsewhere.
DJANGO_TRUST_X_FORWARDED_FOR=true
# Set to false only for a local docker compose run without HTTPS.
DJANGO_SECURE_SSL_REDIRECT=true

# Field-level encryption for health data (ADR 0003). Comma-separated Fernet keys, newest first.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEYS=replace-me-with-a-fernet-key

# One-time login codes: outbox (staff read pending codes in the admin and send them by hand)
# or disabled. "console" (codes in the log) is for local development only.
LOGIN_CODE_SENDER=outbox

# Paymob (Dashboard > Settings > Account info). Leave all four empty to keep checkout closed.
# Integration ids: comma-separated, one per payment method (card, wallet, Fawry...).
PAYMOB_BASE_URL=https://accept.paymob.com
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_IDS=

# PostgreSQL (used by both the app and the postgres container)
POSTGRES_DB=sabaq
POSTGRES_USER=sabaq
POSTGRES_PASSWORD=replace-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis: cache, sessions, Celery broker
REDIS_URL=redis://localhost:6379/0

# Caddy: your domain in staging/production, localhost on your machine
SITE_ADDRESS=localhost
