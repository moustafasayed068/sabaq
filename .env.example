# Copy to .env and replace every value. Never commit .env.
# Generate a key: python -c "import secrets; print(secrets.token_urlsafe(50))"

DJANGO_SECRET_KEY=replace-me-with-a-long-random-value
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://localhost
DJANGO_ADMIN_URL=staff-change-me/
DJANGO_LOG_LEVEL=INFO
# Set to false only for a local docker compose run without HTTPS.
DJANGO_SECURE_SSL_REDIRECT=true

# PostgreSQL (used by both the app and the postgres container)
POSTGRES_DB=sabaq
POSTGRES_USER=sabaq
POSTGRES_PASSWORD=replace-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis: cache, sessions, Celery broker
REDIS_URL=redis://localhost:6379/0

# Caddy: your domain in staging/production, localhost on your machine
SITE_ADDRESS=localhost
